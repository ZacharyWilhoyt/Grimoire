# Copy to .env in backend/, chmod 600 .env, and replace the database credentials.
# Use sslmode=verify-full (and a trusted CA) for a remote PostgreSQL server.
DATABASE_URL=postgresql://grimoire:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:5432/grimoire?sslmode=disable

# Exact browser origin, with no trailing slash. Use localhost consistently.
GRIMOIRE_APP_ORIGIN=http://localhost:5173
# Explicit exception for local HTTP development only. Defaults to false in code.
# Production: remove this line and use an https:// application origin.
GRIMOIRE_DEV_INSECURE_HTTP=true

# Only needed when importing a legacy sources.json from a different location.
# GRIMOIRE_DATA_DIR=data

# GRIMOIRE_PORT=3000
