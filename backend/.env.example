# Copy to .env in backend/, chmod 600 .env, and replace the database credentials.
# Use sslmode=verify-full (and a trusted CA) for a remote PostgreSQL server.
DATABASE_URL=postgresql://grimoire:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:5432/grimoire?sslmode=disable

# Exact browser origin, with no trailing slash. Use localhost consistently.
GRIMOIRE_APP_ORIGIN=http://localhost:5173
# Explicit exception for local HTTP development only. Defaults to false in code.
# Production: remove this line and use an https:// application origin.
GRIMOIRE_DEV_INSECURE_HTTP=true

# Only needed when importing a legacy sources.json from a different location.
# GRIMOIRE_DATA_DIR=data

# GRIMOIRE_PORT=3000

# Online metadata is requested only by source owners through reviewed matching.
# Set false to disable every online lookup; local tags/artwork remain available.
# GRIMOIRE_METADATA_ONLINE=true
# TMDB API Read Access Token (server-side only; never put it in web/ or VITE_*).
# GRIMOIRE_TMDB_TOKEN=REPLACE_WITH_TMDB_READ_ACCESS_TOKEN
# A meaningful application/version/contact User-Agent is required by MusicBrainz.
# GRIMOIRE_METADATA_USER_AGENT=Grimoire/0.1 (+https://your-project.example/contact)

# Optional Arr integration only. Default metadata features need neither setting.
# Generate once with: openssl rand -hex 32
# Keep this 64-hex-character key private and backed up; it encrypts stored Arr keys.
# GRIMOIRE_INTEGRATION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Exact trusted service base URLs reachable FROM THE API. Prefer HTTPS for remote hosts.
# JSON array; keep quotes around the whole value when using dotenv/shell configuration.
# GRIMOIRE_ARR_ALLOWED_URLS='["http://127.0.0.1:8989/","http://127.0.0.1:7878/","http://127.0.0.1:8686/"]'

# Seekable audio copies retain the original video: allow several GiB per file.
# Defaults to GRIMOIRE_DATA_DIR/video-cache (data/video-cache). Avoid a small tmpfs.
# GRIMOIRE_VIDEO_CACHE_DIR=/path/on/large-disk/grimoire-video-cache
# GRIMOIRE_VIDEO_CACHE_MIB=8192

# Optional AMD/Linux VA-API render device for segmented video transcoding.
# The API service needs render-device permissions; no credentials go to clients.
# GRIMOIRE_VAAPI_DEVICE=/dev/dri/renderD128

# Optional additional exact browser origins (JSON array; no trailing slashes).
# GRIMOIRE_ADDITIONAL_APP_ORIGINS='["http://192.168.1.50:5173","http://mechamaru.local:5173"]'
# Private-LAN HTTP testing only; also requires GRIMOIRE_DEV_INSECURE_HTTP=true.
# HTTP sends passwords and sessions without transport encryption. Use HTTPS remotely.
# GRIMOIRE_DEV_ALLOW_LAN_HTTP=true
