FROM alpine:3
ARG TARGETARCH
RUN apk add --no-cache ca-certificates su-exec && apk add --no-cache --virtual .download curl tar && \
    case "$TARGETARCH" in \
      amd64) expected=c863699eee84c6b410573de2ec67af81d07eb054f9020bb98f3c6cb256fea4be2fd1acfbd39110c649c3338282593bba3d3ed6424d91b7f5675e8b877a8999e9 ;; \
      arm64) expected=6a285426268c8f987e0c459f61dc5af3c25e663955c0e4dddc6e187722b7cdd15e4233ff0e570a4ee17b3c68d59e2a61ce96d2f6be55ea58eead6a334859557c ;; \
      *) echo 'Supported proxy architectures: amd64 and arm64' >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/caddyserver/caddy/releases/download/v2.11.8/caddy_2.11.8_linux_${TARGETARCH}.tar.gz" -o /tmp/caddy.tgz && \
    printf '%s  /tmp/caddy.tgz\n' "$expected" | sha512sum -c - && \
    tar -xzf /tmp/caddy.tgz -C /usr/bin caddy && mkdir -p /usr/share/licenses/caddy && tar -xzf /tmp/caddy.tgz -C /usr/share/licenses/caddy LICENSE README.md && rm /tmp/caddy.tgz && apk del .download
ENV XDG_CONFIG_HOME=/config XDG_DATA_HOME=/data
COPY deploy/caddy-entrypoint.sh /usr/local/bin/grimoire-caddy
COPY deploy/bootstrap.Caddyfile /etc/caddy/bootstrap.Caddyfile
ENTRYPOINT ["/usr/local/bin/grimoire-caddy"]
